/target/

# --- Temporary/Backup Files ---
# Backup files generated by rustfmt
**/*.rs.bk

# --- Windows/MSVC Specific ---
# Debugging information files generated by MSVC
*.pdb

# --- Tools/Testing ---
# Generated by cargo-mutants
**/mutants.out/

# Crash reports if the compiler hits an internal error
rustc-ice-*.txt

