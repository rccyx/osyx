QML_RUNNER := `command -v qml6 || command -v qml || { echo "missing qml runner" >&2; exit 1; }`
QMLLINT := `command -v qmllint6 || command -v qmllint || { echo "missing qmllint" >&2; exit 1; }`
QMLFORMAT := `command -v qmlformat6 || command -v qmlformat || { echo "missing qmlformat" >&2; exit 1; }`

l:
    {{QMLLINT}} $(find src -name "*.qml" | sort)

check: fc l s

f:
    {{QMLFORMAT}} -i $(find src -name "*.qml" | sort)

fc:
    #!/usr/bin/env bash
    set -euo pipefail
    failed=0
    while IFS= read -r -d '' f; do
        formatted=$({{QMLFORMAT}} "$f")
        original=$(cat "$f")
        if [[ "$formatted" != "$original" ]]; then
            echo "Not formatted: $f"
            failed=1
        fi
    done < <(find src -name "*.qml" -print0 | sort -z)
    exit $failed

s:
    shellcheck -x -P package package/install package/powyx package/uninstall

r:
    {{QML_RUNNER}} src/Main.qml
