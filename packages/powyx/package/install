#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/_core.sh"
source "$SCRIPT_DIR/lib/_fs.sh"
source "$SCRIPT_DIR/lib/_pkg.sh"
source "$SCRIPT_DIR/lib/_repo.sh"

_powyx_parse_install_args "$@"

_powyx_setup_log "install"
_powyx_find_repo_root "$SCRIPT_DIR"
_powyx_print_install_plan
_powyx_install_runtime_deps
_powyx_install_files_atomically
_powyx_install_default_config
_powyx_verify_install
