#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/_core.sh"
source "$SCRIPT_DIR/lib/_fs.sh"
source "$SCRIPT_DIR/lib/_pkg.sh"
source "$SCRIPT_DIR/lib/_repo.sh"

(($# == 0)) || _powyx_error "arguments are not supported"

_powyx_find_installed_share_dir
_powyx_find_qml_runner
_powyx_read_action_config
_powyx_read_theme_config
_powyx_validate_action_config
_powyx_validate_theme_config
POWYX_EXIT_CODE=0
_powyx_launch_qml || POWYX_EXIT_CODE=$?
_powyx_dispatch_qml_exit_code "$POWYX_EXIT_CODE"
