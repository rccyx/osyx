#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/_core.sh"
source "$SCRIPT_DIR/lib/_fs.sh"
source "$SCRIPT_DIR/lib/_pkg.sh"
source "$SCRIPT_DIR/lib/_repo.sh"

(($# == 0)) || _powyx_error "arguments are not supported"

_powyx_setup_log "uninstall"
_powyx_print_uninstall_plan
_powyx_uninstall_binary
_powyx_uninstall_share
_powyx_preserve_config
_powyx_verify_uninstall
