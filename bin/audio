#!/usr/bin/env bash
set -o pipefail

have() { command -v "$1" >/dev/null 2>&1; }
if [[ -t 2 ]]; then
  ok()   { printf '  \033[32;1m✓\033[0m  %s\n' "$*" >&2; }
  err()  { printf '  \033[31;1m✗\033[0m  %s\n' "$*" >&2; }
  note() { printf '  \033[36m·\033[0m  %s\n' "$*" >&2; }
else
  ok()   { printf 'audio ok   %s\n' "$*" >&2; }
  err()  { printf 'audio err  %s\n' "$*" >&2; }
  note() { printf 'audio      %s\n' "$*" >&2; }
fi
need() {
  local dep missing=0
  for dep in "$@"; do
    if ! have "$dep"; then err "missing dep: $dep"; missing=1; fi
  done
  (( missing == 0 ))
}
notify() { if have notify-send; then notify-send -a jarvis 'jarvis - audio' "$*" -t 2200 2>/dev/null || :; fi; }
default_source() { pactl get-default-source 2>/dev/null || :; }
default_sink()   { pactl get-default-sink 2>/dev/null || :; }
source_rows() {
  local def; def="$(default_source)"
  pactl list short sources 2>/dev/null | awk -v def="$def" '$2 !~ /\.monitor$/ {printf "%s\t%s\t%s\n", ($2 == def ? "*" : " "), $2, $1}'
}
sink_rows() {
  local def; def="$(default_sink)"
  pactl list short sinks 2>/dev/null | awk -v def="$def" '{printf "%s\t%s\t%s\n", ($2 == def ? "*" : " "), $2, $1}'
}
stream_in()  { pactl list short source-outputs 2>/dev/null | awk '{printf "%s\t%s\t%s\n", $1, $3, $4}'; }
stream_out() { pactl list short sink-inputs 2>/dev/null | awk '{printf "%s\t%s\t%s\n", $1, $3, $4}'; }
# pactl operates on PipeWire through pipewire-pulse. The default is set there
# attempting an additional wpctl default is best-effort only.
node_id() {
  local name="$1"
  if have wpctl; then
    wpctl status --name 2>/dev/null | awk -v n="$name" 'index($0,n) {for(i=1;i<=NF;i++) if($i~/^[0-9]+\.$/) {sub(/\.$/,"",$i);print $i;exit}}'
  fi
}
rows_for() { case "$1" in source) source_rows;; sink) sink_rows;; *) return 1;; esac; }
pick() {
  local kind="$1" rows selected
  need fzf || return 1
  rows="$(rows_for "$kind")"
  [[ -n "$rows" ]] || { err "no ${kind}s found"; return 1; }
  # Device names occupy the second tab-separated field. fzf shows the marker and name.
  selected="$(printf '%s\n' "$rows" | fzf --prompt="  audio ${kind} > " --height=50% --reverse --border=rounded --delimiter=$'\t' --with-nth=1,2 --info=hidden --no-scrollbar)" || return 1
  [[ -n "$selected" ]] || return 1
  printf '%s\n' "$selected" | awk -F '\t' '{print $2}'
}
resolve() {
  local kind="$1" query="${2:-}" rows matches count selected
  [[ -n "$query" ]] || { pick "$kind"; return; }
  rows="$(rows_for "$kind")"
  [[ -n "$rows" ]] || { err "no ${kind}s found"; return 1; }
  matches="$(printf '%s\n' "$rows" | awk -F '\t' -v q="$query" 'BEGIN{q=tolower(q)} {n=tolower($2);id=tolower($3); if(n==q || id==q || index(n,q)>0) print}')"
  count="$(printf '%s\n' "$matches" | awk 'NF{n++} END{print n+0}')"
  if (( count == 0 )); then err "${kind} not found: ${query}"; return 1; fi
  if (( count == 1 )); then printf '%s\n' "$matches" | awk -F '\t' '{print $2}'; return; fi
  need fzf || return 1
  selected="$(printf '%s\n' "$matches" | fzf --prompt="  audio ${kind} > " --height=50% --reverse --border=rounded --delimiter=$'\t' --with-nth=1,2 --info=hidden --no-scrollbar)" || return 1
  printf '%s\n' "$selected" | awk -F '\t' '{print $2}'
}
match_device() {
  local kind="$1" label="$2" pattern="$3" rows matches count selected
  rows="$(rows_for "$kind")"
  matches="$(printf '%s\n' "$rows" | grep -Ei "$pattern" || :)"
  count="$(printf '%s\n' "$matches" | awk 'NF{n++} END{print n+0}')"
  if (( count == 0 )); then
    err "no ${label} ${kind} found"; note 'opening general device picker'
    pick "$kind"; return
  fi
  if (( count == 1 )); then printf '%s\n' "$matches" | awk -F '\t' '{print $2}'; return; fi
  need fzf || return 1
  selected="$(printf '%s\n' "$matches" | fzf --prompt="  ${label} > " --height=50% --reverse --border=rounded --delimiter=$'\t' --with-nth=1,2 --info=hidden --no-scrollbar)" || return 1
  printf '%s\n' "$selected" | awk -F '\t' '{print $2}'
}
set_device() {
  local kind="$1" name="$2" id moved=0 stream current
  [[ -n "$name" ]] || return 1
  if [[ "$kind" == source ]]; then
    pactl set-default-source "$name" 2>/dev/null || { err "failed to set input: $name"; return 1; }
  else
    pactl set-default-sink "$name" 2>/dev/null || { err "failed to set output: $name"; return 1; }
  fi
  id="$(node_id "$name")"
  if [[ -n "$id" ]]; then wpctl set-default "$id" >/dev/null 2>&1 || :; fi
  if [[ "$kind" == source ]]; then
    while IFS=$'\t' read -r stream current _; do
      [[ -n "$stream" ]] || continue
      if pactl move-source-output "$stream" "$name" >/dev/null 2>&1; then ((moved+=1)); fi
    done < <(stream_in)
    ok "input      $name"
    (( moved == 0 )) || note "streams    moved $moved active capture stream(s)"
    notify "input → $name"
  else
    while IFS=$'\t' read -r stream current _; do
      [[ -n "$stream" ]] || continue
      if pactl move-sink-input "$stream" "$name" >/dev/null 2>&1; then ((moved+=1)); fi
    done < <(stream_out)
    ok "output     $name"
    (( moved == 0 )) || note "streams    moved $moved active playback stream(s)"
    notify "output → $name"
  fi
}
select_device() { local name; need pactl || return 1; name="$(resolve "$1" "${2:-}")" || return 1; set_device "$1" "$name"; }
select_matching() { local name; need pactl || return 1; name="$(match_device "$1" "$2" "$3")" || return 1; set_device "$1" "$name"; }
volume() {
  local kind="$1" value="${2:-}"
  need pactl || return 1
  if [[ -z "$value" ]]; then
    need fzf || return 1
    if [[ "$kind" == sink ]]; then
      value="$(printf '%s\n' '5%-' '5%+' '10%-' '10%+' '25%' '50%' '75%' '100%' '125%' '150%' | fzf --prompt='  output volume > ' --height=40% --reverse --border=rounded --info=hidden --no-scrollbar)" || return 1
    else
      value="$(printf '%s\n' '5%-' '5%+' '10%-' '10%+' '50%' '75%' '100%' '125%' '150%' | fzf --prompt='  input volume > ' --height=40% --reverse --border=rounded --info=hidden --no-scrollbar)" || return 1
    fi
  fi
  if [[ "$kind" == sink ]]; then
    pactl set-sink-volume @DEFAULT_SINK@ "$value" && ok "output volume $value" || { err 'output volume failed'; return 1; }
  else
    pactl set-source-volume @DEFAULT_SOURCE@ "$value" && ok "input volume $value" || { err 'input volume failed'; return 1; }
  fi
}
mute() {
  need pactl || return 1
  case "${1:-}" in
    in|input|mic) pactl set-source-mute @DEFAULT_SOURCE@ toggle && ok 'input mute toggled' || { err 'input mute failed'; return 1; };;
    out|output|speaker|sink) pactl set-sink-mute @DEFAULT_SINK@ toggle && ok 'output mute toggled' || { err 'output mute failed'; return 1; };;
    *) err 'usage: audio mute in|out'; return 1;;
  esac
}
streams() {
  need pactl || return 1
  note 'capture streams'
  if [[ -z "$(stream_in)" ]]; then printf '  none\n' >&2; else stream_in | awk -F '\t' '{printf "  %-6s source=%-8s client=%s\n",$1,$2,$3}' >&2; fi
  note 'playback streams'
  if [[ -z "$(stream_out)" ]]; then printf '  none\n' >&2; else stream_out | awk -F '\t' '{printf "  %-6s sink=%-8s client=%s\n",$1,$2,$3}' >&2; fi
}
list_devices() {
  need pactl || return 1
  note 'inputs'; source_rows | awk -F '\t' '{printf "  %s  %-6s %s\n",$1,$3,$2}' >&2
  note 'outputs'; sink_rows | awk -F '\t' '{printf "  %s  %-6s %s\n",$1,$3,$2}' >&2
}
status() {
  local src sink cap play
  need pactl || return 1
  src="$(default_source)"; sink="$(default_sink)"
  note "input      ${src:-unknown}"
  note "output     ${sink:-unknown}"
  cap="$(stream_in | awk 'NF{n++} END{print n+0}')"
  play="$(stream_out | awk 'NF{n++} END{print n+0}')"
  note 'active streams'
  printf '  capture   %s\n  playback  %s\n' "$cap" "$play" >&2
  note 'quick graph'
  pactl info 2>/dev/null | awk -F ': ' '/Server Name|Default Sink|Default Source/ {printf "  %-16s %s\n",$1,$2}' >&2
}
test_mic() {
  local seconds="${1:-5}" dir out pid
  need pw-record || return 1
  if [[ ! "$seconds" =~ ^[0-9]+$ ]] || (( seconds < 1 || seconds > 3600 )); then err 'seconds must be an integer from 1 to 3600'; return 1; fi
  dir="${XDG_RUNTIME_DIR:-/tmp}/jarvis-audio-${UID}"
  mkdir -p "$dir" || return 1
  out="${dir}/mic-test-$(date +'%Y-%m-%d_%H-%M-%S').wav"
  note "recording default input for ${seconds}s"
  if have timeout; then
    timeout --signal=INT --kill-after=2 "${seconds}s" pw-record "$out" >/dev/null 2>&1 || :
  else
    pw-record "$out" >/dev/null 2>&1 & pid=$!
    sleep "$seconds"
    kill -INT "$pid" 2>/dev/null || :
    wait "$pid" 2>/dev/null || :
  fi
  [[ -s "$out" ]] || { err 'test recording failed'; return 1; }
  ok "saved      $out"
  notify 'mic test saved'
  if have mpv; then mpv "$out" >/dev/null 2>&1 & fi
}
restart_audio() {
  need systemctl || return 1
  note 'restarting PipeWire, pipewire-pulse, and WirePlumber'
  if systemctl --user restart pipewire pipewire-pulse wireplumber; then
    ok 'restarted PipeWire, pipewire-pulse, WirePlumber'; notify 'PipeWire restarted'
  else
    err 'restart failed'; return 1
  fi
}
help_audio() {
  cat <<'HELP'
audio                   interactive menu
audio in [query]        select microphone; move active capture streams
audio out [query]       select output; move active playback streams
audio pod              select USB / Focusrite / Vocaster / podcast microphone
audio machine          select internal microphone
audio speakers         select internal speaker output
audio headphones       select headphone / Bluetooth / USB / HDMI output
audio mute in|out      toggle input or output mute
audio vol [value]      output volume (e.g. 80%, 10%+, 5%-)
audio micvol [value]   microphone input volume
audio status           show defaults and active stream counts
audio streams          list capture and playback streams
audio ls               list input and output devices
audio tree             show WirePlumber node tree
audio test [seconds]   record a microphone test (default: 5 s)
audio restart          restart PipeWire services
audio help             show this help
HELP
}
main() {
  local cmd="${1:-}" action
  if (( $# )); then shift; fi
  if [[ -z "$cmd" ]]; then
    need fzf || return 1
    action="$(printf '%s\n' \
      'in          set microphone' 'pod         use pod mic' 'machine     use internal mic' \
      'out         set output' 'speakers    use internal speakers' 'headphones  use headphones' \
      'status      show defaults' 'streams     show active streams' 'ls          list devices' \
      'tree        show wpctl graph' 'mute-in     toggle input mute' 'mute-out    toggle output mute' \
      'vol         output volume' 'micvol      input volume' 'test        record mic test' \
      'restart     restart audio graph' 'help        show help' | \
      fzf --prompt='  audio > ' --height=50% --reverse --border=rounded --info=hidden --no-scrollbar)" || return 1
    cmd="${action%% *}"
  fi
  case "$cmd" in
    in|input|mic|asr) select_device source "${1:-}";;
    out|output|sink) select_device sink "${1:-}";;
    pod|vocaster|focusrite|scarlett|usb) select_matching source 'pod mic' 'vocaster|focusrite|scarlett|clarett|usb|rode|shure|pod';;
    machine|internal|laptop) select_matching source 'machine mic' 'alsa_input\.pci|alsa_input\.platform|sof|hda|built.?in|internal';;
    speakers|speaker) select_matching sink 'machine output' 'alsa_output\.pci|alsa_output\.platform|sof|hda|speaker|built.?in|internal|analog-stereo';;
    headphones|headphone|bluetooth|bt|hdmi) select_matching sink 'headphones' 'headphone|headset|bluetooth|bluez|usb|hdmi';;
    mute-in|mutein) mute in;;
    mute-out|muteout) mute out;;
    mute) mute "${1:-}";;
    vol|volume) volume sink "${1:-}";;
    micvol|gain) volume source "${1:-}";;
    st|status) status;;
    streams|apps) streams;;
    ls|list|devices) list_devices;;
    tree|graph) need wpctl && wpctl status --name;;
    test) test_mic "${1:-5}";;
    restart|reload) restart_audio;;
    help|-h|--help) help_audio;;
    *) select_device source "$cmd";;
  esac
}
main "$@"
