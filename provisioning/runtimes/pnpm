#!/usr/bin/env bash
set -Eeuo pipefail

command -v npm >/dev/null 2>&1 && npm uninstall -g pnpm >/dev/null 2>&1 || true
command -v corepack >/dev/null 2>&1 && corepack disable pnpm >/dev/null 2>&1 || true
rm -rf "$HOME/.cache/node/corepack"

old_pnpm=$(command -v pnpm 2>/dev/null || true)
if [[ -n "$old_pnpm" && "$old_pnpm" != "$HOME/.local/share/pnpm"* ]]; then
  rm -f "$old_pnpm"
fi

export PNPM_HOME="$HOME/.local/share/pnpm"
mkdir -p "$PNPM_HOME"

curl -fsSL https://get.pnpm.io/install.sh | sh -

export PATH="$PNPM_HOME:$PATH"

pnpm config set store-dir "$PNPM_HOME/store"
